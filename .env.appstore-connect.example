# Copy to .env.appstore-connect (gitignored). App Store Connect API key with App Manager role.
APPSTORE_CONNECT_KEY_ID=XXXXXXXXXX
APPSTORE_CONNECT_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Path to the .p8, relative to the repo root (keep it out of git).
APPSTORE_CONNECT_KEY_FILE=AuthKey_XXXXXXXXXX.p8
APPSTORE_CONNECT_BUNDLE_ID=com.vanities.earmark
