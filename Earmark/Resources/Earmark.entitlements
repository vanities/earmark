<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Simulator + (once Apple grants it for the App ID) device. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
	<!-- iCloud key-value storage for cross-device listening progress. Works in the simulator now;
	     enable iCloud on the App ID in the developer portal to add it to device builds too. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
